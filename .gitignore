# Secrets
.env
*.pem
*.key

# Python
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.ruff_cache/

# Environments and model output live in *.nosync directories (iCloud never
# syncs that suffix) behind symlinks at the usual names. Ignore both: the
# directory-only pattern `.venv/` does not match a symlink.
.venv
.venv/
checkpoints
checkpoints/
*.nosync/
*.nosync

# Model weights never go in git
*.safetensors
*.bin
*.pt
*.onnx

# Run outputs. Committed: results/runs/*.json, results/ac2.json and
# results/logits-manifest.json (SHA-256 of every logits archive). Not
# committed: the archives themselves (about 5 MB each, about 40 runs);
# they are attached to a GitHub Release and checked with `make verify-logits`.
results/summary.md
results/logits/
*.npz
*.tmp

# iCloud conflict copies ("name 2")
* [0-9]*

# OS / editors
.DS_Store
.vscode/
.idea/
*.swp
